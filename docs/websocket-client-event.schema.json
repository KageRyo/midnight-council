{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midnight-council.local/schemas/websocket-client-event.schema.json",
  "title": "Midnight Council WebSocket Client Event",
  "$defs": {
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ready"],
      "properties": {
        "type": { "const": "ready" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "ready": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "start_game" },
        "sequence": { "$ref": "#/$defs/sequence" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "const": "chat" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "message": {
          "type": "string",
          "maxLength": 500,
          "pattern": "\\S"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_id"],
      "properties": {
        "type": { "const": "night_action" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "target_id": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "night_pass" },
        "sequence": { "$ref": "#/$defs/sequence" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "start_vote" },
        "sequence": { "$ref": "#/$defs/sequence" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "vote" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "target_id": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_id"],
      "properties": {
        "type": { "const": "shoot" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "target_id": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_id"],
      "properties": {
        "type": { "const": "transfer_owner" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "target_id": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_id"],
      "properties": {
        "type": { "const": "kick_participant" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "target_id": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "locked"],
      "properties": {
        "type": { "const": "set_room_locked" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "locked": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "max_players"],
      "properties": {
        "type": { "const": "set_player_limit" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "max_players": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "night_duration",
        "day_discussion_duration",
        "day_voting_duration",
        "last_words_duration",
        "minimum_players",
        "reveal_roles_on_death",
        "killers",
        "detectives",
        "doctors",
        "escorts",
        "shooters"
      ],
      "properties": {
        "type": { "const": "set_game_settings" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "night_duration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "day_discussion_duration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "day_voting_duration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "last_words_duration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "minimum_players": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "reveal_roles_on_death": { "type": "boolean" },
        "killers": { "const": 1 },
        "detectives": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "doctors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "escorts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "shooters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "preset"],
      "properties": {
        "type": { "const": "set_game_preset" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "preset": {
          "enum": ["STANDARD", "QUICK", "BEGINNER", "ADVANCED", "MINIMAL"]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "afk"],
      "properties": {
        "type": { "const": "presence" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "afk": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "return_to_waiting" },
        "sequence": { "$ref": "#/$defs/sequence" }
      }
    }
  ]
}
