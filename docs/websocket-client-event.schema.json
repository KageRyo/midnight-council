{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midnight-council.local/schemas/websocket-client-event.schema.json",
  "title": "Midnight Council WebSocket Client Event",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ready"],
      "properties": {
        "type": { "const": "ready" },
        "ready": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "start_game" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "const": "chat" },
        "message": {
          "type": "string",
          "maxLength": 500,
          "pattern": "\\S"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_id"],
      "properties": {
        "type": { "const": "night_action" },
        "target_id": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "night_pass" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "start_vote" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "vote" },
        "target_id": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_id"],
      "properties": {
        "type": { "const": "shoot" },
        "target_id": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  ]
}
